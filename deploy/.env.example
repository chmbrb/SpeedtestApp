# Copy of what ./setup.sh writes, with explanations. Do not commit your real .env.

# --- secrets (setup.sh generates these; use letters and digits only, they go into a URL) ---
DB_ADMIN_PASSWORD=
DB_APP_PASSWORD=

# Who may send results to /api/v1/results: "device=token,device2=token2". The token decides the device name.
API_TOKENS=server=

# --- where people reach the app (set these to this machine's address, so your phone can follow the links) ---
HTTP_PORT=8080
# HTTPS (Caddy, with its own private certificate authority; no domain needed). HTTPS_HOSTS is every address or name people
# type to reach this machine, separated by a comma and a space, in quotes, for example "192.168.0.7, speedtest.lan" (Caddy
# refuses a comma without the space). The first is the default: browsers send no name when you type an IP address, so if people
# type the IP, list it first. Browsers only allow installing the app and notifications on https pages.
HTTPS_PORT=8443
HTTPS_HOSTS=localhost
APP_URL=https://localhost:8443
NTFY_PORT=8081
NTFY_BASE_URL=http://localhost:8081
TIMEZONE=UTC

# --- dashboard login (optional) ---
# One shared password for the whole dashboard, 8 to 200 characters. Empty (the default) means no login: anyone who can reach the
# dashboard can open it. It is kept here in plain text, like every other secret in this file, so use one you use nowhere else.
# Changing it signs everybody out. Use https (see HTTPS_HOSTS): over plain http the password crosses your network unencrypted.
# DASHBOARD_PASSWORD=
# How long a sign-in lasts, in days (1 to 365).
# DASHBOARD_SESSION_DAYS=30

# --- notifications (ntfy runs in this stack, private: nobody can read or publish without a login) ---
NTFY_TOPIC=
NTFY_BACKEND_PASSWORD=
NTFY_BACKEND_HASH=
NTFY_PHONE_PASSWORD=
NTFY_PHONE_HASH=
# NTFY_UPSTREAM_BASE_URL=https://ntfy.sh   # only for instant notifications on iPhones
# Only scheduled tests are judged, each against its own device's history (server against server, laptop against laptop).
# How many of them in a row must be outliers (slow, or lossy) before you are notified. Unset means 1.
# NTFY_OUTLIERS=1

# --- browser and installed-app notifications (Web Push) ---
# On by default. They carry the same alerts as ntfy, so NTFY_TOPIC must be set too.
# PUSH_ENABLED=no
# Who the server says it is to the browser makers' push services: an https address or an email. Defaults to APP_URL.
# PUSH_SUBJECT=
# Extra push-service hosts to accept, beyond Chrome/Edge, Firefox, Safari and Windows (a leading dot means "and subdomains").
# PUSH_ALLOWED_HOSTS=

# --- on-demand tests ---
DEVICE_NAME=server
SERVER_CONNECTION_TYPE=wired
# Leave empty until you have read Ookla's terms (https://www.speedtest.net/about/eula) and agree to them. Then set it to: yes
OOKLA_ACCEPT_LICENSE=

# --- container logs ---
# Each container keeps at most LOG_MAX_FILE log files of LOG_MAX_SIZE each (the oldest is dropped first). These are the defaults.
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
